<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Someday, Together – Shokher Corner</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Lato:wght@300;400&family=Dancing+Script:wght@600&display=swap" rel="stylesheet"/>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{--burgundy:#4A1729;--wine:#2D101D;--ivory:#F8F1E8;--cream:#EFE3D5;--rose:#C58F98;--blush:#E8C7CA;--gold:#C5A16D;}
body{font-family:'Lato',sans-serif;background:var(--ivory);color:var(--wine);overflow-x:hidden;}
h1,h2,h3{font-family:'Cormorant Garamond',serif;}
nav{position:sticky;top:0;z-index:100;background:rgba(248,241,232,0.95);backdrop-filter:blur(10px);border-bottom:1px solid rgba(74,23,41,0.15);}
.nav-inner{max-width:1200px;margin:auto;display:flex;align-items:center;justify-content:space-between;padding:1rem 1.5rem;}
.nav-brand{font-family:'Cormorant Garamond',serif;font-size:1.5rem;color:var(--burgundy);text-decoration:none;}
.nav-links{display:flex;gap:1.2rem;list-style:none;}
.nav-links a{text-decoration:none;color:var(--wine);font-size:.82rem;transition:color .3s;}
.nav-links a:hover,.nav-links a.active{color:var(--burgundy);}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:4px;}
.hamburger span{display:block;width:24px;height:2px;background:var(--wine);}
.mobile-nav{display:none;flex-direction:column;background:var(--ivory);border-top:1px solid rgba(74,23,41,0.1);}
.mobile-nav a{padding:.8rem 1.5rem;text-decoration:none;color:var(--wine);border-bottom:1px solid rgba(74,23,41,0.05);}
.mobile-nav.open{display:flex;}
@media(max-width:768px){.nav-links{display:none;}.hamburger{display:flex;}}
.page-hero{background:linear-gradient(160deg,var(--wine),var(--burgundy));padding:6rem 2rem 4rem;text-align:center;}
.page-label{font-size:.75rem;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:.8rem;}
.page-title{font-size:clamp(2.5rem,6vw,4rem);color:var(--ivory);margin-bottom:1rem;}
.page-sub{color:var(--blush);font-style:italic;font-size:1.1rem;}
.dreams-wrap{max-width:1000px;margin:5rem auto;padding:0 1.5rem 5rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:2rem;}
.dream-card{background:var(--cream);padding:1.8rem;border-top:3px solid var(--gold);transition:.4s;}
.dream-card:hover{transform:translateY(-4px);box-shadow:0 8px 25px rgba(45,16,29,.1);}
.dream-title{font-size:1.3rem;color:var(--burgundy);margin-bottom:.6rem;}
.dream-desc{font-size:.88rem;line-height:1.75;color:var(--wine);margin-bottom:1rem;}
.dream-status{display:flex;gap:.5rem;flex-wrap:wrap;}
.status-btn{font-size:.7rem;letter-spacing:1.5px;text-transform:uppercase;padding:.4rem .9rem;border:1px solid currentColor;cursor:pointer;background:transparent;transition:.3s;}
.status-btn.dreaming{color:var(--rose);border-color:var(--rose);}
.status-btn.planned{color:var(--gold);border-color:var(--gold);}
.status-btn.done{color:#6a9a6a;border-color:#6a9a6a;}
.status-btn.active-dreaming{background:var(--rose);color:var(--ivory);}
.status-btn.active-planned{background:var(--gold);color:var(--wine);}
.status-btn.active-done{background:#6a9a6a;color:var(--ivory);}
footer{background:var(--wine);color:rgba(248,241,232,.6);text-align:center;padding:2rem;font-size:.8rem;}
footer a{color:var(--gold);text-decoration:none;}
</style>
</head>
<body>
<nav>
  <div class="nav-inner">
    <a href="index.html" class="nav-brand">Shokher Corner</a>
    <ul class="nav-links">
      <li><a href="our-story.html">Our Story</a></li><li><a href="shokher-corner.html">Shokher Corner</a></li>
      <li><a href="memory-vault.html">Memory Vault</a></li><li><a href="letters.html">Letters</a></li>
      <li><a href="open-when.html">Open When</a></li><li><a href="little-things.html">Little Things</a></li>
      <li><a href="our-universe.html">Our Universe</a></li><li><a href="someday.html" class="active">Someday</a></li>
      <li><a href="soundtrack.html">Soundtrack</a></li><li><a href="reasons.html">Reasons</a></li>
      <li><a href="secret-room.html">✦ Secret</a></li>
    </ul>
    <button class="hamburger" id="hamburger"><span></span><span></span><span></span></button>
  </div>
  <div class="mobile-nav" id="mobileNav">
    <a href="index.html">Home</a><a href="our-story.html">Our Story</a><a href="shokher-corner.html">Shokher Corner</a>
    <a href="memory-vault.html">Memory Vault</a><a href="letters.html">Letters</a><a href="open-when.html">Open When</a>
    <a href="little-things.html">Little Things</a><a href="our-universe.html">Our Universe</a>
    <a href="someday.html">Someday</a><a href="soundtrack.html">Soundtrack</a><a href="reasons.html">Reasons</a>
    <a href="secret-room.html">✦ Secret Room</a>
  </div>
</nav>
<div class="page-hero">
  <p class="page-label">Chapter Eight</p>
  <h1 class="page-title">Someday, Together</h1>
  <p class="page-sub">There are still so many beautiful moments waiting for us.</p>
</div>
<div class="dreams-wrap" id="dreamsGrid"></div>
<footer><p><a href="index.html">← Back to Home</a> &nbsp;·&nbsp; Someday, Together &nbsp;·&nbsp; Shokher Corner</p></footer>
<script>
document.getElementById('hamburger').addEventListener('click',()=>document.getElementById('mobileNav').classList.toggle('open'));
const dreams=[
  {id:'shapla',title:'Shapla Bil in the Rain',desc:'One of her most beautiful wishes — to visit Shapla Bil when the rain falls. The kind of day that feels like a dream.'},
  {id:'blue-saree',title:'Blue Saree at TSC',desc:'She wishes to wear a blue saree and visit TSC in the rain. This one deserves a whole day built around it.'},
  {id:'orchid',title:'Orchid Flowers',desc:'To give her orchids someday. She mentioned this wish, and I have not forgotten it.'},
  {id:'art-gallery',title:'An Art Gallery Together',desc:'To visit an art gallery together. She has an artistic eye — she would see things in every painting that most people walk past.'},
  {id:'coffee-date',title:'A Coffee Date',desc:'A simple, beautiful coffee date. Just us, a warm cup, and a good conversation.'},
  {id:'badminton',title:'Badminton Together',desc:'Playing badminton with her. I imagine she is competitive in the most delightful way.'},
  {id:'stage-dance',title:'Dancing in Front of a Stage',desc:'One of her wishes — to dance in front of a stage. I want to be there when she does.'},
  {id:'kadam',title:'Kadam Flowers',desc:'To bring her kadam flowers. These were on her list, and they are still waiting for the right season.'},
  {id:'beli',title:'Beli Flowers in Her Hair',desc:'To put beli flowers in her hair someday. I think this would suit her perfectly.'},
  {id:'singing',title:'Hear Her Sing',desc:'She wishes to sing. I wish to listen.'},
  {id:'proposal',title:'A One-Knee Proposal',desc:'[Edit this — a dream for the future, written only when you are ready.]'},
  {id:'more',title:'[Add Another Dream]',desc:'[Edit this — add any other future dream you want to plan together.]'},
];
const grid=document.getElementById('dreamsGrid');
dreams.forEach(d=>{
  const saved=localStorage.getItem('dream_'+d.id)||'dreaming';
  const card=document.createElement('div');card.className='dream-card';
  card.innerHTML=`<h3 class="dream-title">${d.title}</h3><p class="dream-desc">${d.desc}</p><div class="dream-status">
    <button class="status-btn dreaming ${saved==='dreaming'?'active-dreaming':''}" onclick="setStatus('${d.id}',this,'dreaming')">Dreaming</button>
    <button class="status-btn planned ${saved==='planned'?'active-planned':''}" onclick="setStatus('${d.id}',this,'planned')">Planned</button>
    <button class="status-btn done ${saved==='done'?'active-done':''}" onclick="setStatus('${d.id}',this,'done')">Done ✓</button>
  </div>`;
  grid.appendChild(card);
});
function setStatus(id,btn,status){
  localStorage.setItem('dream_'+id,status);
  const btns=btn.closest('.dream-status').querySelectorAll('.status-btn');
  btns.forEach(b=>{b.classList.remove('active-dreaming','active-planned','active-done');});
  btn.classList.add('active-'+status);
}
</script>
</body>
</html>
