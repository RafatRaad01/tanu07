<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Secret Room – Shokher Corner</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Lato:wght@300;400&family=Dancing+Script:wght@600&display=swap" rel="stylesheet"/>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{--burgundy:#4A1729;--wine:#2D101D;--ivory:#F8F1E8;--cream:#EFE3D5;--rose:#C58F98;--blush:#E8C7CA;--gold:#C5A16D;}
body{font-family:'Lato',sans-serif;background:var(--wine);color:var(--ivory);overflow-x:hidden;min-height:100vh;}
h1,h2,h3{font-family:'Cormorant Garamond',serif;}

/* LOCK SCREEN */
#lockScreen{position:fixed;inset:0;z-index:999;background:linear-gradient(135deg,var(--wine),#1a0812,var(--burgundy));display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:2rem;}
#lockScreen::before{content:'';position:absolute;inset:0;opacity:.05;background:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");pointer-events:none;}
.lock-icon{font-size:4rem;margin-bottom:1.5rem;animation:float 3s ease-in-out infinite;}
@keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-10px);}}
.lock-label{font-size:.75rem;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:1rem;}
.lock-title{font-size:clamp(2rem,5vw,3.5rem);color:var(--ivory);margin-bottom:.8rem;}
.lock-sub{color:var(--blush);font-style:italic;margin-bottom:2.5rem;}
.pw-form{display:flex;flex-direction:column;align-items:center;gap:1rem;width:100%;max-width:320px;}
.pw-input{width:100%;padding:1rem 1.5rem;background:rgba(248,241,232,.08);border:1px solid rgba(197,161,109,.4);color:var(--ivory);font-size:1.2rem;letter-spacing:4px;text-align:center;outline:none;font-family:'Lato',sans-serif;}
.pw-input:focus{border-color:var(--gold);background:rgba(248,241,232,.12);}
.pw-btn{width:100%;padding:1rem;background:var(--gold);color:var(--wine);border:none;font-size:.85rem;letter-spacing:3px;text-transform:uppercase;cursor:pointer;font-family:'Lato',sans-serif;transition:.3s;}
.pw-btn:hover{background:var(--ivory);}
.pw-error{color:var(--rose);font-size:.85rem;font-style:italic;min-height:1.2rem;}
.lock-out{animation:lockOut .6s ease forwards;}
@keyframes lockOut{to{opacity:0;transform:scale(1.05);pointer-events:none;visibility:hidden;}}

/* SECRET ROOM */
#secretRoom{display:none;min-height:100vh;background:linear-gradient(to bottom,var(--wine),#120610);}
#secretRoom.show{display:block;}
nav.dark{position:sticky;top:0;z-index:100;background:rgba(29,10,20,0.95);backdrop-filter:blur(10px);border-bottom:1px solid rgba(197,161,109,0.2);}
.nav-inner{max-width:1200px;margin:auto;display:flex;align-items:center;justify-content:space-between;padding:1rem 1.5rem;}
.nav-brand-dark{font-family:'Cormorant Garamond',serif;font-size:1.5rem;color:var(--gold);text-decoration:none;}
.nav-links-dark{display:flex;gap:1.2rem;list-style:none;}
.nav-links-dark a{text-decoration:none;color:rgba(248,241,232,.6);font-size:.82rem;transition:color .3s;}
.nav-links-dark a:hover{color:var(--gold);}
.hamburger-dark{display:none;flex-direction:column;gap:5px;cursor:pointer;background:none;border:none;padding:4px;}
.hamburger-dark span{display:block;width:24px;height:2px;background:var(--gold);}
.mobile-nav-dark{display:none;flex-direction:column;background:var(--wine);border-top:1px solid rgba(197,161,109,.2);}
.mobile-nav-dark a{padding:.8rem 1.5rem;text-decoration:none;color:var(--blush);border-bottom:1px solid rgba(197,161,109,.1);}
.mobile-nav-dark.open{display:flex;}
@media(max-width:768px){.nav-links-dark{display:none;}.hamburger-dark{display:flex;}}

.unlock-sequence{text-align:center;padding:5rem 2rem 3rem;max-width:700px;margin:0 auto;}
.unlock-msg{font-family:'Cormorant Garamond',serif;font-size:1.8rem;color:var(--ivory);opacity:0;animation:msgIn .8s ease forwards;line-height:1.5;}
.unlock-msg:nth-child(2){animation-delay:.8s;}
.unlock-msg:nth-child(3){animation-delay:1.6s;}
.unlock-msg:nth-child(4){font-style:italic;color:var(--blush);font-size:1.2rem;animation-delay:2.4s;margin-top:1rem;}
@keyframes msgIn{to{opacity:1;transform:translateY(0);}from{opacity:0;transform:translateY(15px);}}

.section{max-width:800px;margin:3rem auto;padding:0 1.5rem;}
.secret-section{background:rgba(248,241,232,.05);border:1px solid rgba(197,161,109,.2);padding:2.5rem;margin-bottom:2rem;}
.sec-label{font-size:.7rem;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin-bottom:.6rem;}
.sec-title{font-size:2rem;color:var(--ivory);margin-bottom:1rem;}
.sec-text{font-size:.92rem;line-height:1.9;color:var(--blush);white-space:pre-line;}
.sign{font-family:'Dancing Script',cursive;font-size:1.3rem;color:var(--rose);text-align:right;margin-top:1.5rem;}

/* Hidden photo */
.reveal-wrap{text-align:center;margin:1.5rem 0;}
.reveal-img{max-width:100%;max-height:350px;object-fit:cover;filter:blur(20px);transition:filter 1.5s ease;cursor:pointer;display:none;}
.reveal-img.shown{display:block;margin:1rem auto;}
.reveal-img.clear{filter:blur(0);}
.reveal-btn{background:none;border:1px solid var(--gold);color:var(--gold);padding:.8rem 2rem;font-size:.8rem;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:.3s;}
.reveal-btn:hover{background:var(--gold);color:var(--wine);}
.reveal-caption{font-family:'Dancing Script',cursive;color:var(--rose);margin-top:.8rem;font-size:1rem;}

/* Notes */
.notes-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem;margin-top:1rem;}
.note{background:rgba(197,161,109,.1);border:1px solid rgba(197,161,109,.2);padding:1.2rem;font-size:.88rem;line-height:1.6;color:var(--blush);cursor:pointer;transition:.3s;}
.note:hover{background:rgba(197,161,109,.2);transform:translateY(-2px);}

/* Gift box */
.gift-wrap{text-align:center;margin-top:1.5rem;}
.gift-icon{font-size:4rem;cursor:pointer;transition:.3s;display:inline-block;}
.gift-icon:hover{transform:scale(1.1);}
.gift-msg{color:var(--blush);font-style:italic;font-size:.95rem;line-height:1.7;margin-top:1rem;display:none;animation:msgIn .6s ease forwards;}

/* Lock again btn */
.lock-again-btn{display:block;margin:3rem auto 1rem;background:none;border:1px solid rgba(197,161,109,.4);color:rgba(248,241,232,.5);padding:.7rem 2rem;font-size:.75rem;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:.3s;}
.lock-again-btn:hover{border-color:var(--gold);color:var(--gold);}
.final-quote{text-align:center;padding:3rem 2rem;font-family:'Dancing Script',cursive;font-size:1.4rem;color:var(--rose);line-height:1.6;}
.btn-home{display:inline-block;margin-top:1.5rem;background:var(--gold);color:var(--wine);padding:.8rem 2rem;text-decoration:none;font-size:.8rem;letter-spacing:2px;text-transform:uppercase;transition:.3s;}
.btn-home:hover{background:var(--ivory);}
footer{background:rgba(0,0,0,.3);color:rgba(248,241,232,.3);text-align:center;padding:2rem;font-size:.8rem;}
footer a{color:var(--gold);text-decoration:none;}
</style>
</head>
<body>

<!-- LOCK SCREEN -->
<div id="lockScreen">
  <span class="lock-icon">🔒</span>
  <p class="lock-label">A little secret</p>
  <h1 class="lock-title">A Little Secret...</h1>
  <p class="lock-sub">Some things are too special to be shown to everyone.</p>
  <div class="pw-form">
    <input type="password" class="pw-input" id="pwInput" placeholder="Enter our secret" maxlength="10" autocomplete="off"/>
    <button class="pw-btn" onclick="tryUnlock()">Unlock My Little World</button>
    <p class="pw-error" id="pwError"></p>
  </div>
</div>

<!-- SECRET ROOM -->
<div id="secretRoom">
  <nav class="dark">
    <div class="nav-inner">
      <a href="index.html" class="nav-brand-dark">Shokher Corner</a>
      <ul class="nav-links-dark">
        <li><a href="our-story.html">Our Story</a></li><li><a href="shokher-corner.html">Shokher Corner</a></li>
        <li><a href="memory-vault.html">Memory Vault</a></li><li><a href="letters.html">Letters</a></li>
        <li><a href="open-when.html">Open When</a></li><li><a href="little-things.html">Little Things</a></li>
        <li><a href="our-universe.html">Our Universe</a></li><li><a href="someday.html">Someday</a></li>
        <li><a href="soundtrack.html">Soundtrack</a></li><li><a href="reasons.html">Reasons</a></li>
        <li><a href="secret-room.html">✦ Secret</a></li>
      </ul>
      <button class="hamburger-dark" id="hamburger"><span></span><span></span><span></span></button>
    </div>
    <div class="mobile-nav-dark" id="mobileNav">
      <a href="index.html">Home</a><a href="our-story.html">Our Story</a><a href="shokher-corner.html">Shokher Corner</a>
      <a href="memory-vault.html">Memory Vault</a><a href="letters.html">Letters</a><a href="open-when.html">Open When</a>
      <a href="little-things.html">Little Things</a><a href="our-universe.html">Our Universe</a>
      <a href="someday.html">Someday</a><a href="soundtrack.html">Soundtrack</a><a href="reasons.html">Reasons</a>
    </div>
  </nav>

  <!-- Unlock sequence -->
  <div class="unlock-sequence">
    <p class="unlock-msg">Finally, you found it!</p>
    <p class="unlock-msg">I was waiting for you, Pakhi.</p>
    <p class="unlock-msg">Welcome to your little secret world.</p>
    <p class="unlock-msg">I saved a few things here that belong only to us.</p>
  </div>

  <div class="section">
    <!-- Secret Letter -->
    <div class="secret-section">
      <p class="sec-label">One thing I want you to know</p>
      <h2 class="sec-title">One Thing I Want You to Know...</h2>
      <p class="sec-text">My dearest Pakhi,

There are so many little things about you that I keep in my heart. Some of them may seem ordinary to everyone else, but to me, they are memories I never want to lose.

I remember your little wishes, your smile, and the moments when I got to make you happy.

I made this little place because I wanted you to have something that feels like us.

And no matter how many pages this website has, there will always be a little corner of my heart that belongs only to you.</p>
      <p class="sign">— Yours, always.</p>
    </div>

    <!-- Hidden photo -->
    <div class="secret-section">
      <p class="sec-label">Something I want you to see</p>
      <h2 class="sec-title">There's Something I Want You to See</h2>
      <div class="reveal-wrap">
        <button class="reveal-btn" id="revealBtn" onclick="revealPhoto()">Reveal the Memory</button>
        <img id="hiddenPhoto" class="reveal-img" src="public/assets/images/secret/hidden-photo.jpg" alt="A hidden memory"/>
        <p class="reveal-caption" id="revealCaption" style="display:none;">[Edit this caption — write what this photograph means to you.]</p>
      </div>
    </div>

    <!-- Secret Notes -->
    <div class="secret-section">
      <p class="sec-label">Little secret notes</p>
      <h2 class="sec-title">Little Things I Keep</h2>
      <div class="notes-grid">
        <div class="note">You make ordinary days feel special.</div>
        <div class="note">I remember more little things about you than you think.</div>
        <div class="note">Your happiness matters to me.</div>
        <div class="note">Some memories are my favourite places.</div>
        <div class="note">You are my favourite little coincidence.</div>
      </div>
    </div>

    <!-- Gift Box -->
    <div class="secret-section" style="text-align:center;">
      <p class="sec-label">One more thing</p>
      <h2 class="sec-title">There's One More Thing...</h2>
      <div class="gift-wrap">
        <span class="gift-icon" onclick="openGift()" id="giftIcon" title="Click to open">🎁</span>
        <p class="gift-msg" id="giftMsg">Surprise! If I could give you one thing, it would be the ability to see yourself through my eyes.<br/><br/><em style="font-family:'Dancing Script',cursive;font-size:1.1rem;color:var(--rose);">[Edit this — add your own personal surprise message here.]</em></p>
      </div>
    </div>

    <!-- Final message -->
    <div class="final-quote">
      <p>"Even if you explore every corner of this website,<br/>there will always be a little more love left to discover."</p>
      <br/>
      <p style="font-size:1rem;color:rgba(248,241,232,.6);font-family:'Lato',sans-serif;margin-top:1rem;">Made with love, just for you.</p>
      <br/>
      <a href="index.html" class="btn-home">Back to Our Little World</a>
    </div>
    <button class="lock-again-btn" onclick="lockAgain()">🔒 Lock the Secret Room</button>
  </div>
  <footer><p><a href="index.html">← Back to Home</a> &nbsp;·&nbsp; Secret Room &nbsp;·&nbsp; Shokher Corner</p></footer>
</div>

<script>
document.getElementById('hamburger').addEventListener('click',()=>document.getElementById('mobileNav').classList.toggle('open'));
// Auto-unlock if already unlocked this session
if(sessionStorage.getItem('secretUnlocked')==='true')unlock(false);
function tryUnlock(){
  const v=document.getElementById('pwInput').value.trim();
  if(v==='18114'){unlock(true);}
  else{const e=document.getElementById('pwError');e.textContent='Hmm... that\'s not quite our little secret. Try again, sweetheart.';document.getElementById('pwInput').value='';}
}
function unlock(animate){
  sessionStorage.setItem('secretUnlocked','true');
  const ls=document.getElementById('lockScreen');
  if(animate){ls.classList.add('lock-out');setTimeout(()=>{ls.style.display='none';document.getElementById('secretRoom').classList.add('show');},600);}
  else{ls.style.display='none';document.getElementById('secretRoom').classList.add('show');}
}
function lockAgain(){
  sessionStorage.removeItem('secretUnlocked');
  document.getElementById('secretRoom').classList.remove('show');
  document.getElementById('lockScreen').style.display='flex';
  document.getElementById('lockScreen').classList.remove('lock-out');
  document.getElementById('pwInput').value='';
  document.getElementById('pwError').textContent='';
}
function revealPhoto(){
  document.getElementById('revealBtn').style.display='none';
  const img=document.getElementById('hiddenPhoto');img.classList.add('shown');
  setTimeout(()=>img.classList.add('clear'),100);
  document.getElementById('revealCaption').style.display='block';
}
function openGift(){
  document.getElementById('giftIcon').textContent='🎊';
  document.getElementById('giftMsg').style.display='block';
}
document.getElementById('pwInput').addEventListener('keydown',e=>{if(e.key==='Enter')tryUnlock();});
</script>
</body>
</html>
